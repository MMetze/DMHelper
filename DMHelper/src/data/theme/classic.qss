QWidget#CustomTableFrame, #CustomTableFrame QWidget,
QWidget#DiceRollDialog, #DiceRollDialog QWidget,
QWidget#DiceRollDialogCombatants, #DiceRollDialogCombatants QWidget,
QWidget#DiceRollFrame, #DiceRollFrame QWidget,
QWidget#DMHWaitingDialog, #DMHWaitingDialog QWidget,
QWidget#DMScreenTabWidget, #DMScreenTabWidget QWidget,
