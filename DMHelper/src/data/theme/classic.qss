QWidget#LayerVideoEffectSettings, #LayerVideoEffectSettings QWidget,
QWidget#LegalDialog, #LegalDialog QWidget,
QWidget#MapBlankDialog, #MapBlankDialog QWidget,
QWidget#MapColorizeDialog, #MapColorizeDialog QWidget,
QWidget#MapManagerDialog, #MapManagerDialog QWidget,
QWidget#MapSelectDialog, #MapSelectDialog QWidget,
QWidget#MonsterActionEditDialog, #MonsterActionEditDialog QWidget,
QWidget#MonsterActionFrame, #MonsterActionFrame QWidget,
QWidget#NewCampaignDialog, #NewCampaignDialog QWidget,
QWidget#NewEntryDialog, #NewEntryDialog QWidget,
QWidget#ObjectImportDialog, #ObjectImportDialog QWidget,
QWidget#OptionsDialog, #OptionsDialog QWidget,
QWidget#OverlayFrame, #OverlayFrame QWidget,
QWidget#OverlaysEditDialog, #OverlaysEditDialog QWidget,
QWidget#PartyCharacterGridFrame, #PartyCharacterGridFrame QWidget,
