QWidget#ExpertiseDialog, #ExpertiseDialog QWidget,
QWidget#ExportDialog, #ExportDialog QWidget,
QWidget#FearFrame, #FearFrame QWidget,
QWidget#GlobalSearchFrame, #GlobalSearchFrame QWidget,
QWidget#HelpDialog, #HelpDialog QWidget,
QWidget#InitiativeEventWidget, #InitiativeEventWidget QWidget,
QWidget#InitiativeListDialog, #InitiativeListDialog QWidget,
QWidget#ItemSelectDialog, #ItemSelectDialog QWidget,
