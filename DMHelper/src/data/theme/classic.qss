QWidget#TokenEditDialog, #TokenEditDialog QWidget,
QWidget#WelcomeFrame, #WelcomeFrame QWidget,
QWidget#WhatsNewDialog, #WhatsNewDialog QWidget {
    background-image: url(:/img/data/parchment.jpg);
}

QWidget#DiceRollFrame, #DiceRollFrame QWidget {
    color: rgb(0, 0, 0);
}

QWidget#EncounterTextEdit, #EncounterTextEdit QWidget {
    background-color: rgb(238, 238, 238);
}

QWidget#MapFrame, #MapFrame QWidget {
    background-image: url(:/img/data/parchment.jpg);
}

QGroupBox#MapFrame, #MapFrame QGroupBox {
    border: 2px solid gray;
    border-radius: 3px;
}

/* Several old inline sheets mixed bare declarations with a "QFrame{ background: transparent; }" rule.
   Qt cannot parse that mix, so only the bare declarations ever took effect; those rules are not recreated. */

/* ---- 2. Promoted forms: their own sheet was nearer than the hosting ribbon/form ---- */
QWidget#PublishButtonRibbon, #PublishButtonRibbon QWidget, #MainWindow PublishButtonRibbon, #MainWindow PublishButtonRibbon QWidget {
    background-color: rgb(238, 238, 238);
}

/* ---- 3. Widgets inside forms that carried their own sheet ---- */
#EncounterTextEdit #textBrowser, #EncounterTextEdit #textBrowser QWidget,
#LayerEffectSettings #dialDirection, #LayerEffectSettings #dialDirection QWidget {
    background-image: url(:/img/data/parchment.jpg);
}

#TimeAndDateFrame #timeEdit, #TimeAndDateFrame #timeEdit QWidget {
    background-image: url(:/img/data/parchment.jpg);
    background-color: rgb(200, 200, 200);
}

#EncounterTextEdit #textFormatter, #EncounterTextEdit #textFormatter QWidget,
#CustomTableFrame #listWidget, #CustomTableFrame #listWidget QWidget,
#CustomTableFrame #listEntries, #CustomTableFrame #listEntries QWidget,
#CustomTableFrame #edtResult, #CustomTableFrame #edtResult QWidget,
#MapManagerDialog #treeView, #MapManagerDialog #treeView QWidget,
#MapManagerDialog #frame, #MapManagerDialog #frame QWidget,
#MapManagerDialog #lblPreview, #MapManagerDialog #lblPreview QWidget,
#MapManagerDialog #edtTags, #MapManagerDialog #edtTags QWidget,
#NewEntryDialog #textBrowserEntry, #NewEntryDialog #textBrowserEntry QWidget,
#NewEntryDialog QFrame#frameEntryType, #NewEntryDialog #frameEntryType QFrame,
#NewEntryDialog QFrame#frameEntryDetails, #NewEntryDialog #frameEntryDetails QFrame,
#RandomMarketDialog #cmbLocation, #RandomMarketDialog #cmbLocation QWidget,
#RandomMarketDialog #cmbShop, #RandomMarketDialog #cmbShop QWidget {
    background: transparent;
}

#LegalDialog #plainTextEdit, #LegalDialog #plainTextEdit QWidget {
    background-color: rgb(240, 240, 240);
}

#MonsterActionEditDialog #line_5, #MonsterActionEditDialog #line_5 QWidget,
#MonsterActionFrame #line_5, #MonsterActionFrame #line_5 QWidget {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(50, 50, 50, 255), stop:1 rgba(50, 50, 50, 0));
}

#CharacterTemplateFrame QLabel#lblDndBeyondLink,
#PresentUpdateDialog QLabel#lblWebsiteLink {
    color: rgb(0, 0, 255);
}
