QWidget#RandomMarketDialog, #RandomMarketDialog QWidget,
QWidget#RibbonTabAudio, #RibbonTabAudio QWidget,
QWidget#RibbonTabBattle, #RibbonTabBattle QWidget,
QWidget#RibbonTabBattleMap, #RibbonTabBattleMap QWidget,
QWidget#RibbonTabBattleView, #RibbonTabBattleView QWidget,
QWidget#RibbonTabCampaign, #RibbonTabCampaign QWidget,
QWidget#RibbonTabFile, #RibbonTabFile QWidget,
QWidget#RibbonTabMap, #RibbonTabMap QWidget,
QWidget#RibbonTabText, #RibbonTabText QWidget,
QWidget#RibbonTabTools, #RibbonTabTools QWidget,
QWidget#RibbonTabWorldMap, #RibbonTabWorldMap QWidget,
QWidget#SelectCombatantDialog, #SelectCombatantDialog QWidget,
QWidget#SelectItemDialog, #SelectItemDialog QWidget,
QWidget#SelectStringDialog, #SelectStringDialog QWidget,
QWidget#SelectZoom, #SelectZoom QWidget,
QWidget#SoundboardFrame, #SoundboardFrame QWidget,
QWidget#SoundBoardGroupFrame, #SoundBoardGroupFrame QWidget,
QWidget#SoundboardTrackFrame, #SoundboardTrackFrame QWidget,
QWidget#SpellbookTemplateDialog, #SpellbookTemplateDialog QWidget,
