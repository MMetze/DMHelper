/* DMHelper Classic theme - the parchment look formerly set inline in every .ui file.

   An inline styleSheet applied to its widget and all descendants, and a nearer (inner) sheet beat
   an outer one regardless of specificity. In one application sheet that is emulated by:
     - "QWidget#Form, #Form QWidget" for a form's plain declarations (specificity 101)
     - "#Form #child" (200+) for declarations that were set on a widget inside a form
   Promoted forms (embedded through another .ui) lose their objectName, so they are also matched by class. */

/* ---- 1. Every form: parchment background (MainWindow first, it encloses everything else) ---- */
QWidget#MainWindow, #MainWindow QWidget,
QWidget#AboutDialog, #AboutDialog QWidget,
QWidget#AudioPlaybackFrame, #AudioPlaybackFrame QWidget,
QWidget#AudioTrackEdit, #AudioTrackEdit QWidget,
QWidget#BattleCombatantWidget, #BattleCombatantWidget QWidget,
QWidget#BattleDialogEffectSettings, #BattleDialogEffectSettings QWidget,
QWidget#BattleDialogEffectSettingsFire, #BattleDialogEffectSettingsFire QWidget,
QWidget#BattleDialogEffectSettingsLight, #BattleDialogEffectSettingsLight QWidget,
QWidget#BattleDialogEffectSettingsObjectVideo, #BattleDialogEffectSettingsObjectVideo QWidget,
QWidget#BattleDialogEffectSettingsSmoke, #BattleDialogEffectSettingsSmoke QWidget,
QWidget#BattleDialogEffectSettingsSparks, #BattleDialogEffectSettingsSparks QWidget,
QWidget#BattleDialogLogView, #BattleDialogLogView QWidget,
QWidget#BattleFrame, #BattleFrame QWidget,
QWidget#BestiaryExportDialog, #BestiaryExportDialog QWidget,
QWidget#BestiaryPopulateTokensDialog, #BestiaryPopulateTokensDialog QWidget,
QWidget#BestiaryTemplateDialog, #BestiaryTemplateDialog QWidget,
QWidget#CharacterImportDialog, #CharacterImportDialog QWidget,
QWidget#CharacterImportHeroForgeDialog, #CharacterImportHeroForgeDialog QWidget,
QWidget#CharacterTemplateFrame, #CharacterTemplateFrame QWidget,
QWidget#ClockFrame, #ClockFrame QWidget,
QWidget#CombatantDialog, #CombatantDialog QWidget,
QWidget#CombatantGroupWidget, #CombatantGroupWidget QWidget,
